# Copy to .env.local and fill in.

# MongoDB (docker compose up -d starts one on localhost).
MONGODB_URI=mongodb://127.0.0.1:27017/sealed

# 32 random bytes, base64. Encrypts salaries and payroll vault keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# devnet, or localnet for Surfpool / a local validator with the ZK ElGamal proof program.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# RPC the browser uses. Defaults to the public devnet RPC, or http://127.0.0.1:8899 for localnet.
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# RPC the server uses, if different (e.g. a private devnet RPC).
# RPC_URL=

# The built-in browser test wallet (on by default; never use it for real funds).
# NEXT_PUBLIC_ENABLE_TEST_WALLET=true
